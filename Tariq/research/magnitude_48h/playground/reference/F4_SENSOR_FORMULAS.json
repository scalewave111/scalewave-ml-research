    "inputs": "[{\"role\": \"value\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.time_since_peak.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "BOUNDED_OR_DISCRETE",
    "f4z_transform": "NONE",
    "f4z_domain": "NONNEGATIVE"
  },
  {
