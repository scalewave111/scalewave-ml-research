    "zero_policy": "NULL and invalid when the slow ATR is non-positive",
    "invalid_policy": "NULL and invalid when either exact F2 parent is unresolved or invalid",
    "operator": "FAST_OVER_SLOW_SAME_UNIT",
    "sensor_id": "sensor.cascade.confirmation.range_expansion.v1",
