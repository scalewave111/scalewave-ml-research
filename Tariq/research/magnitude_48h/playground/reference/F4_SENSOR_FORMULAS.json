    "inputs": "[{\"role\": \"atr\", \"family\": \"VOLATILITY\", \"template_id\": \"memory.volatility.{scope}.mean_true_range_atr.v1\", \"scope\": \"binance\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "POSITIVE_OR_RATIO",
    "f4z_transform": "LN_POSITIVE_RATIO",
    "f4z_domain": "STRICT_POSITIVE"
  },
  {
    "ordinal": "11",
    "name": "liq_peak_age_seconds",
    "output_family": "LIQUIDATION",
    "formula": "time_since_peak(h)",
    "unit": "seconds",
