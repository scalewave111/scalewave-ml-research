[
  {
    "ordinal": "1",
    "name": "liq_activity_severity",
    "output_family": "LIQUIDATION",
    "formula": "active = rolling_total_quote(h) > 0; value = rolling_total_quote(h)",
    "unit": "quote_notional",
    "orientation": "larger non-negative value means more published liquidation activity",
    "instance_policy": "ALL_LEGAL_SINGLE_HORIZONS",
    "zero_policy": "valid zero and inactive when the F2 total is valid zero",
    "invalid_policy": "NULL and invalid when the exact F2 parent is unresolved or invalid",
    "operator": "EVENT_HURDLE_DIRECT",
    "sensor_id": "sensor.liquidation.core.activity_severity.v1",
    "definition_sha256": "cb7ad06218b499ab8a09fe48af35c841a97f3c4bdedeab1890cc6c8e9fa3acf1",
    "inputs": "[{\"role\": \"total\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_total_quote.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "EVENT_HURDLE",
    "f4z_transform": "LN_1P_ACTIVE_VALUE",
    "f4z_domain": "NONNEGATIVE_EVENT"
  },
  {
    "ordinal": "2",
    "name": "liq_side_pressure",
    "output_family": "LIQUIDATION",
    "formula": "(rolling_short_quote(h)-rolling_long_quote(h))/rolling_total_quote(h)",
    "unit": "fraction",
    "orientation": "positive means forced buying; negative means forced selling",
    "instance_policy": "ALL_LEGAL_SINGLE_HORIZONS",
    "zero_policy": "NULL and invalid when total is zero",
    "invalid_policy": "NULL and invalid when any exact F2 parent is unresolved or invalid",
    "operator": "SHORT_MINUS_LONG_OVER_TOTAL",
    "sensor_id": "sensor.liquidation.core.side_pressure.v1",
    "definition_sha256": "897f398ad01205e26114d0a973e5e89d1d12a3f60ea962464d49ed3eb08d4d64",
    "inputs": "[{\"role\": \"long\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_long_quote.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"short\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_short_quote.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"total\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_total_quote.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "SIGNED_CONTINUOUS",
    "f4z_transform": "IDENTITY",
    "f4z_domain": "ANY_REAL"
  },
  {
    "ordinal": "3",
    "name": "liq_fast_slow_lift",
    "output_family": "LIQUIDATION",
    "formula": "(total(fast_h)/total(slow_h))/(fast_seconds/slow_seconds)",
    "unit": "multiple",
    "orientation": "above one means liquidation is temporally concentrated in the fast child",
    "instance_policy": "ALL_ORDERED_HORIZON_PAIRS",
    "zero_policy": "NULL and invalid when the slow total is zero",
    "invalid_policy": "NULL and invalid when either exact F2 parent is unresolved or invalid",
    "operator": "DURATION_ADJUSTED_FAST_OVER_SLOW",
    "sensor_id": "sensor.liquidation.core.fast_slow_lift.v1",
    "definition_sha256": "6c8afd7260e685dd7c6343f8d267fce3872b43085f80723e6b75dc5773da7e0f",
    "inputs": "[{\"role\": \"total\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_total_quote.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "POSITIVE_OR_RATIO",
    "f4z_transform": "LN_POSITIVE_RATIO",
    "f4z_domain": "STRICT_POSITIVE"
  },
  {
    "ordinal": "4",
    "name": "cross_asset_liq_activity_raw",
    "output_family": "LIQUIDATION",
    "formula": "sum both manifest-declared peer assets' cross-venue rolling_total_quote(h), excluding target",
    "unit": "quote_notional",
    "orientation": "larger non-negative value means more raw peer liquidation activity; it is not calibrated stress",
    "instance_policy": "ALL_LEGAL_SINGLE_HORIZONS",
    "zero_policy": "valid zero when both peers are valid zero",
    "invalid_policy": "NULL and invalid unless both declared peer coordinates exist and are valid",
    "operator": "PEER_SUM_EXCLUDING_TARGET",
    "sensor_id": "sensor.liquidation.scope.cross_asset_liq_activity_raw.v1",
    "definition_sha256": "a0b1048f83dbe339a9b72a72e27706726eca92cf7c4e654a4379cd44f252708b",
    "inputs": "[{\"role\": \"peer_total\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_total_quote.v1\", \"scope\": \"cross_venue\", \"asset_policy\": \"BOTH_PEERS_EXCLUDING_TARGET\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "EVENT_HURDLE",
    "f4z_transform": "LN_1P_ACTIVE_VALUE",
    "f4z_domain": "NONNEGATIVE_EVENT"
  },
  {
    "ordinal": "5",
    "name": "venue_breadth",
    "output_family": "LIQUIDATION",
    "formula": "observed_venue_breadth(h)/N_eligible",
    "unit": "fraction",
    "orientation": "higher means broader eligible-venue participation",
    "instance_policy": "ALL_LEGAL_SINGLE_HORIZONS",
    "zero_policy": "valid zero only when complete eligible-venue evidence records no event",
    "invalid_policy": "NULL and invalid when F2 breadth is invalid",
    "operator": "ELIGIBLE_FRACTION",
    "sensor_id": "sensor.liquidation.scope.venue_breadth.v1",
    "definition_sha256": "72bc89f468c4fd520e8c6a55da9d45f856e39eacdd5c5a4c3abd454d96e8f80b",
    "inputs": "[{\"role\": \"breadth\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.observed_venue_breadth.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "BOUNDED_OR_DISCRETE",
    "f4z_transform": "NONE",
    "f4z_domain": "UNIT_INTERVAL"
  },
  {
    "ordinal": "6",
    "name": "venue_fragmentation",
    "output_family": "LIQUIDATION",
    "formula": "(1-HHI(h))/(1-1/N_eligible)",
    "unit": "fraction",
    "orientation": "zero means one-venue concentration; one means equal eligible-venue distribution",
    "instance_policy": "ALL_LEGAL_SINGLE_HORIZONS",
    "zero_policy": "NULL and invalid when total liquidation is zero",
    "invalid_policy": "NULL and invalid when F2 HHI is invalid",
    "operator": "INVERTED_NORMALIZED_HHI",
    "sensor_id": "sensor.liquidation.scope.venue_fragmentation.v1",
    "definition_sha256": "4b14cde5705fca4b3fc39babaa8687144424dab954fa71a3ab2422fadda5b4b2",
    "inputs": "[{\"role\": \"hhi\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.venue_concentration_hhi.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "BOUNDED_OR_DISCRETE",
    "f4z_transform": "NONE",
    "f4z_domain": "UNIT_INTERVAL"
  },
  {
    "ordinal": "7",
    "name": "flow_confirmation",
    "output_family": "FLOW",
    "formula": "((short_liq-long_liq)/total_liq)*((taker_buy-taker_sell)/(taker_buy+taker_sell)) at matched h",
    "unit": "fraction_squared",
    "orientation": "positive means aggressive trade flow agrees with forced-flow direction; negative means opposition",
    "instance_policy": "ALL_LEGAL_MATCHED_HORIZONS",
    "zero_policy": "NULL and invalid when either directional denominator is zero",
    "invalid_policy": "NULL and invalid when any exact F2 parent is unresolved or invalid",
    "operator": "DIRECTION_PRODUCT",
    "sensor_id": "sensor.cascade.confirmation.flow_confirmation.v1",
    "definition_sha256": "321e93a32be1a6a38ee6a1406e93fafa6339e2887f0f7cdc9ea39cde6a5dc16b",
    "inputs": "[{\"role\": \"long\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_long_quote.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"short\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_short_quote.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"total\", \"family\": \"LIQUIDATION\", \"template_id\": \"memory.liquidation.{scope}.rolling_total_quote.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"buy\", \"family\": \"FLOW\", \"template_id\": \"memory.flow.{scope}.rolling_taker_buy_quote.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"sell\", \"family\": \"FLOW\", \"template_id\": \"memory.flow.{scope}.rolling_taker_sell_quote.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1s,1m",
    "f4z_class": "SIGNED_CONTINUOUS",
    "f4z_transform": "IDENTITY",
    "f4z_domain": "ANY_REAL"
  },
  {
    "ordinal": "8",
    "name": "leverage_unwind",
    "output_family": "OI",
    "formula": "-ln(last_genuine_OI(h)/first_genuine_OI(h))",
    "unit": "log_fraction",
    "orientation": "positive means leverage removed; negative means leverage added",
    "instance_policy": "ALL_LEGAL_SINGLE_HORIZONS",
    "zero_policy": "NULL and invalid when either endpoint is non-positive",
    "invalid_policy": "NULL and invalid under F2-OI-001 or any unusable exact F2 endpoint",
    "operator": "NEGATIVE_LOG_LAST_OVER_FIRST",
    "sensor_id": "sensor.cascade.fuel.leverage_unwind.v1",
    "definition_sha256": "4580a4300707b730fbb7391aba2ed9c49e9f0e32e2c4fb610ff1af907a4ef4c8",
    "inputs": "[{\"role\": \"first\", \"family\": \"OI\", \"template_id\": \"memory.oi.{scope}.first_genuine_level.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"last\", \"family\": \"OI\", \"template_id\": \"memory.oi.{scope}.last_genuine_level.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1m",
    "f4z_class": "SIGNED_CONTINUOUS",
    "f4z_transform": "IDENTITY",
    "f4z_domain": "ANY_REAL"
  },
  {
    "ordinal": "9",
    "name": "remaining_recent_oi_fraction",
    "output_family": "OI",
    "formula": "last_genuine_OI(h)/maximum_genuine_OI(h)",
    "unit": "fraction",
    "orientation": "one means current OI remains at the horizon maximum; lower means recent OI has been removed",
    "instance_policy": "ALL_LEGAL_SINGLE_HORIZONS",
    "zero_policy": "NULL and invalid when the trailing maximum is non-positive",
    "invalid_policy": "NULL and invalid under F2-OI-001 or any unusable exact F2 parent",
    "operator": "LAST_OVER_TRAILING_MAX",
    "sensor_id": "sensor.cascade.fuel.remaining_recent_oi_fraction.v1",
    "definition_sha256": "c697ebad15d58f17c36d4da388522a772f84daa710ff5f160a20b62369cedcac",
    "inputs": "[{\"role\": \"last\", \"family\": \"OI\", \"template_id\": \"memory.oi.{scope}.last_genuine_level.v1\", \"scope\": \"cross_venue\"}, {\"role\": \"maximum\", \"family\": \"OI\", \"template_id\": \"memory.oi.{scope}.maximum_genuine_level.v1\", \"scope\": \"cross_venue\"}]",
    "source_clocks": "1m",
    "f4z_class": "BOUNDED_OR_DISCRETE",
    "f4z_transform": "NONE",
    "f4z_domain": "UNIT_INTERVAL"
  },
  {
    "ordinal": "10",
    "name": "range_expansion",
    "output_family": "VOLATILITY",
    "formula": "binance mean_true_range_atr(fast_h)/binance mean_true_range_atr(slow_h)",
    "unit": "multiple",
    "orientation": "above one means recent traded-price range is expanding relative to the slower path",
